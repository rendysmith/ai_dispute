# Копия: cp .env.example .env (заполнить реальными значениями).
# На VDS: положить как /opt/ai-contestation/.env.

# === Google Sheets (сервисный аккаунт) ===
# Файл НЕ хранится в git. Локально: utils/service_account.json.
# В Docker монтируется с хоста (secrets/service_account.json); при желании
# путь можно переопределить:
# SERVICE_ACCOUNT_FILE=/app/utils/service_account.json

# === Docker (на VDS, в .env сервера) ===
# Какой образ тянуть при автодеплое:
# IMAGE=ghcr.io/<ваш-github>/<репозиторий>:latest

# === PostgreSQL (токены ИИ, правила форумов, прокси) ===
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DB=postgres
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=postgres

# === Авторизация API (Basic Auth) ===
# Логин/пароль для точек /api/v1/data/get_feedbacks, /run, /tasks, /capacity.
# Те же креды используются для запроса к ферме. Если не заданы — точки открыты.
HOST_USERNAME=
HOST_PASSWORD=

# === AI ===
# Токен и модель GPT берутся из таблицы tokens (username='chat_gpt') в БД

# === Парсинг ===
# headless/proxy для браузеров (если не заданы — автоопределение по IP)
HEADLESS=true
PROXY_ON=false
# Максимальная пауза ожидания между запросами (сек)
MAX_SEC=30

# === Планировщик ресурсов (admission control) ===
# Лимиты берутся из cgroup автоматически; можно переопределить:
# POD_CPU_LIMIT=2
# POD_MEM_GB_LIMIT=4
# Вес одного запуска каждой точки (CPU ядер / ГБ памяти)
TASK_CPU_RUN=1.0
TASK_MEM_RUN=1.5
TASK_CPU_GET_FEEDBACK=0.7
TASK_MEM_GET_FEEDBACK=1.0
# Базовое потребление самого сервиса
BASE_CPU=0.3
BASE_MEM_GB=0.5
# Время жизни задач (сек)
TASK_TIMEOUT_SEC=28800
FEEDBACK_TIMEOUT_SEC=900

# === Captcha (otzovik.com) ===
CAPTCHA_KEY=
CAPTCHA_SERVER=2captcha.com
